<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LT6MS Launcher</AssemblyName>
    <RootNamespace>Enchanted</RootNamespace>
    <Product>LT6MS лаунчер</Product>
    <Title>LT6MS лаунчер</Title>
    <Description>LT6MS Minecraft Launcher</Description>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('enchanted.ico')">
    <ApplicationIcon>enchanted.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="enchanted.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('client_mod/lt6.jar')">
    <EmbeddedResource Include="client_mod/lt6.jar" LogicalName="lt6.jar" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
