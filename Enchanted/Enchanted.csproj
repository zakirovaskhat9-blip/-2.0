<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Enchanted</AssemblyName>
    <RootNamespace>Enchanted</RootNamespace>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('enchanted.ico')">
    <ApplicationIcon>enchanted.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="enchanted.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('client_mod/enchanted-client.jar')">
    <EmbeddedResource Include="client_mod/enchanted-client.jar" LogicalName="enchanted-client.jar" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
