<Window x:Class="Enchanted.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enchanted" Width="1280" Height="820" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" KeyDown="Window_KeyDown" Icon="enchanted.ico" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Acc" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>

    <Style x:Key="Play" TargetType="Button">
      <Setter Property="Foreground" Value="#0A0A0A"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="16" Background="#F2F2F2" Height="60">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#555555"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Background="#1A1A1A" Padding="12,9" Margin="0,0,8,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2A2A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9A9A9A"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="12" Background="#1A1A1A" Padding="14,10" Margin="0,0,8,0">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#303030"/><Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2A2A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="12" Background="#1A1A1A" Padding="14,11">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="22" BorderBrush="#33FFFFFF" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#050505" Offset="0"/><GradientStop Color="#101010" Offset="0.5"/><GradientStop Color="#000000" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="0">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Grid x:Name="Title" Background="Transparent" MouseLeftButtonDown="Title_Down">
        <TextBlock Text="ENCHANTED" Foreground="#9A9A9A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="26,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,12,0">
          <Button Style="{StaticResource Chrome}" Content="—" Click="Min_Click"/>
          <Button Style="{StaticResource Chrome}" Content="✕" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="24,0,24,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- левая панель -->
        <Border CornerRadius="20" Background="#CC0C0C0C" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="24">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Border Width="64" Height="64" CornerRadius="18" Background="#0F0F0F" BorderBrush="#F2F2F2" BorderThickness="2">
                <TextBlock Text="E" FontSize="42" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Effect><DropShadowEffect Color="#FFFFFF" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/></TextBlock.Effect>
                </TextBlock>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Enchanted" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="лаунчер Minecraft" FontSize="13" Foreground="#9A9A9A"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,26,0,0">
              <TextBlock Text="Ник" Foreground="#9A9A9A" Margin="2,0,0,6"/>
              <TextBox x:Name="NickBox" Style="{StaticResource Field}" MaxLength="16"/>
              <TextBlock Text="Версия" Foreground="#9A9A9A" Margin="2,18,0,6"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="V1" Style="{StaticResource Seg}" Content="1.21.11" GroupName="v"/>
                <RadioButton x:Name="V2" Style="{StaticResource Seg}" Content="1.21.4" GroupName="v"/>
              </StackPanel>
              <TextBlock Text="Источник загрузки" Foreground="#9A9A9A" Margin="2,18,0,6"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="S1" Style="{StaticResource Seg}" Content="Зеркала" GroupName="s"/>
                <RadioButton x:Name="S2" Style="{StaticResource Seg}" Content="Официальные" GroupName="s"/>
              </StackPanel>
              <CheckBox x:Name="VerifyBox" Content="Проверять файлы игры при запуске" Foreground="#9A9A9A" Margin="2,18,0,0"/>
              <TextBlock Text="Скин" Foreground="#9A9A9A" Margin="2,18,0,6"/>
              <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="10" Background="#1A1A1A" Margin="0,0,10,0" ClipToBounds="True">
                  <Image x:Name="SkinFace" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <Button Style="{StaticResource Ghost}" Content="Выбрать скин…" Click="PickSkin_Click" VerticalAlignment="Center"/>
                <CheckBox x:Name="SlimBox" Content="Slim (Alex)" Foreground="#9A9A9A" VerticalAlignment="Center" Checked="Slim_Changed" Unchecked="Slim_Changed"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3">
              <Button x:Name="PlayBtn" Style="{StaticResource Play}" Content="ИГРАТЬ" Click="Play_Click"/>
              <ProgressBar x:Name="Bar" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="1" Foreground="#F2F2F2" Background="#1A1A1A" BorderThickness="0"/>
              <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#9A9A9A" Margin="2,10,0,16" TextWrapping="Wrap" MinHeight="36"/>
              <WrapPanel>
                <Button Style="{StaticResource Ghost}" Content="Minecraft" Click="OpenGame_Click"/>
                <Button Style="{StaticResource Ghost}" Content="Моды" Click="OpenMods_Click"/>
                <Button Style="{StaticResource Ghost}" Content="Ресурспаки" Click="OpenPacks_Click"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- правая панель: состояние модов -->
        <Border Grid.Column="2" CornerRadius="20" Background="#CC0C0C0C" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="28">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Моды" FontSize="24" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="Недостающие моды докачиваются при запуске: Release → Modrinth → MCIM → CurseForge." Foreground="#9A9A9A" Margin="0,6,0,18" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ModsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="12" Background="#151515" Padding="14,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{Binding Dot}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="15"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#9A9A9A" FontSize="13"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <TextBlock Text="Сервер скинов (адрес, чтобы видеть скины других игроков)" Foreground="#9A9A9A" Margin="2,0,0,6"/>
              <TextBox x:Name="SkinServerBox" Style="{StaticResource Field}" FontSize="13" LostFocus="SkinServer_LostFocus"/>
              <TextBlock Text="Меню клиента в игре — правый Shift. F11 — полный экран." Foreground="#9A9A9A" Margin="0,12,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
