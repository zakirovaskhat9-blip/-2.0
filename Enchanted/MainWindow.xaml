<Window x:Class="Enchanted.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LT6MS Launcher" Width="1190" Height="770" MinWidth="980" MinHeight="620"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="#101720" Icon="enchanted.ico"
        KeyDown="Window_KeyDown" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#EDF4FC"/>
    <SolidColorBrush x:Key="Dim" Color="#94A9C1"/>
    <SolidColorBrush x:Key="Accent" Color="#77BCFF"/>

    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#AFBFD1"/>
      <Setter Property="Height" Value="47"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="17,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#5C85AD"/><Setter TargetName="bg" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="#71B9FC"/>
      <Setter Property="Foreground" Value="#0B1C2C"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="19,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="11" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#A5D8FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value=".40"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#E5F1FF"/>
      <Setter Property="Background" Value="#223349"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="#39536D" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#304965"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F3F8FF"/>
      <Setter Property="Background" Value="#182637"/>
      <Setter Property="BorderBrush" Value="#405875"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style x:Key="Option" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D3E2F1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#182536"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="#304660"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A9C1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#0C121B" BorderBrush="#283B53" BorderThickness="0,0,0,1">
      <Grid x:Name="Title" Background="Transparent" MouseLeftButtonDown="Title_Down">
        <StackPanel Orientation="Horizontal" Margin="21,0" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#7AC9FF" Margin="0,0,11,0"/>
          <TextBlock Text="LT6MS" Foreground="#E8F5FF" FontSize="14" FontWeight="Bold"/>
          <TextBlock Text="   /   Minecraft launcher" Foreground="#728AA7" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
          <Button Content="—" Click="Min_Click" Style="{StaticResource Ghost}" Background="Transparent" BorderThickness="0" Padding="17,7"/>
          <Button Content="□" Click="Max_Click" Style="{StaticResource Ghost}" Background="Transparent" BorderThickness="0" Padding="17,7"/>
          <Button Content="✕" Click="Close_Click" Style="{StaticResource Ghost}" Background="Transparent" BorderThickness="0" Padding="17,7"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="223"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#101A28" BorderBrush="#2B3D54" BorderThickness="0,0,1,0">
        <DockPanel Margin="15,22">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="8,3,0,30">
              <Border Background="#284462" CornerRadius="12" Width="50" Height="50">
                <Image Source="enchanted.ico" Width="43" Height="43"/>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="LT6MS" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="VISUAL CLIENT" Foreground="#7E98B4" FontSize="10"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="БИБЛИОТЕКА" Foreground="#657F9B" FontSize="10" Margin="13,0,0,12" FontWeight="Bold"/>
            <Button x:Name="NavHome" Style="{StaticResource Nav}" Content="⌂    Играть" Click="Nav_Home"/>
            <Button x:Name="NavMods" Style="{StaticResource Nav}" Content="▦    Modrinth / Моды" Click="Nav_Mods" Margin="0,4,0,0"/>
            <Button x:Name="NavCapes" Style="{StaticResource Nav}" Content="◈    Плащи" Click="Nav_Capes" Margin="0,4,0,0"/>
            <Button x:Name="NavFiles" Style="{StaticResource Nav}" Content="▤    Файлы и небо" Click="Nav_Files" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="#314258" Margin="7,15"/>
            <TextBlock Text="Minecraft Java · Fabric" Foreground="#A0B7CA" FontSize="12" Margin="12,0,0,4"/>
            <TextBlock Text="Моды: официальный Modrinth" Foreground="#667F9B" FontSize="11" Margin="12,0,0,4"/>
            <TextBlock Text="LT6 GUI: клавиша Y" Foreground="#667F9B" FontSize="11" Margin="12,0,0,4"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="27,22,27,23">
        <!-- HOME -->
        <Grid x:Name="HomePage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border CornerRadius="17" Padding="28,25" Height="160" BorderBrush="#46698B" BorderThickness="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#234261" Offset="0"/>
                <GradientStop Color="#172C46" Offset="0.55"/>
                <GradientStop Color="#293150" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <StackPanel>
                <TextBlock Text="Твоя игра. Твои моды." Foreground="#F6FAFF" FontSize="29" FontWeight="SemiBold"/>
                <TextBlock Text="LT6 — лёгкий лаунчер с Modrinth, Custom Sky и настройками клиента" Foreground="#B6CEE5" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Собирай свой набор модов и запускай Minecraft одним нажатием." Foreground="#90AEC9" FontSize="12" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,17,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,17,0">
                <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource SmallLabel}" Margin="0,0,0,9"/>
                <TextBlock Text="Ник игрока" Foreground="#E7F1FC" Margin="0,0,0,8"/>
                <TextBox x:Name="NickBox" Style="{StaticResource Field}" MaxLength="16"/>
                <TextBlock Text="Локальный профиль без авторизации Microsoft" Style="{StaticResource SmallLabel}" Margin="0,9,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="ВЕРСИЯ FABRIC" Style="{StaticResource SmallLabel}" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                  <RadioButton x:Name="V1" Content="1.21.11" Foreground="#EAF4FF" GroupName="v" Checked="VersionChanged" Margin="0,0,22,0"/>
                  <RadioButton x:Name="V2" Content="1.21.4" Foreground="#EAF4FF" GroupName="v" Checked="VersionChanged"/>
                </StackPanel>
                <CheckBox x:Name="VerifyBox" Style="{StaticResource Option}" Content="Проверять файлы при запуске"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,17,0,17" VerticalAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="ТВОЯ СБОРКА" Style="{StaticResource SmallLabel}" Margin="0,0,0,11"/>
              <TextBlock x:Name="HomeModsText" Text="Оптимизационные моды · персональные настройки" Foreground="#F1F7FE" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Моды будут проверены и установлены перед запуском. Необязательные можно отключать на вкладке «Моды»." Foreground="#94ACC6" TextWrapping="Wrap" Margin="0,10,0,16"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Настроить моды" Style="{StaticResource Ghost}" Click="Nav_Mods" Margin="0,0,10,0"/>
                <Button Content="Загрузить плащ" Style="{StaticResource Ghost}" Click="Nav_Capes"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="4,0,12,0">
                <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#E2EEFB" FontSize="13" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Bar" Margin="0,13,0,0" Height="5" Minimum="0" Maximum="1" Background="#273C51" Foreground="#72BCFF" BorderThickness="0"/>
              </StackPanel>
              <Button x:Name="PlayBtn" Grid.Column="1" Style="{StaticResource Primary}" Content="▶  ИГРАТЬ" Click="Play_Click"/>
            </Grid>
          </Border>
        </Grid>

        <!-- MODS AND MODRINTH -->
        <Grid x:Name="ModsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Моды и Modrinth" FontSize="29" FontWeight="SemiBold" Foreground="#F2F8FF"/>
            <TextBlock Text="Управляй оптимизацией и добавляй Fabric-моды. Установка — при следующем запуске игры." Foreground="#9EB3CE" Margin="0,7,0,16" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource Field}" VerticalContentAlignment="Center" KeyDown="Search_KeyDown" ToolTip="Название мода на Modrinth"/>
              <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectedIndex="0" Margin="9,0" Background="#22354B" Foreground="White" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Все моды" Tag="all"/>
                <ComboBoxItem Content="Оптимизация" Tag="optimization"/>
                <ComboBoxItem Content="Утилиты" Tag="utility"/>
                <ComboBoxItem Content="Визуальные" Tag="decoration"/>
              </ComboBox>
              <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Поиск" FontSize="13" Click="Search_Click"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="УСТАНОВЛЕННЫЕ И ВЫБРАННЫЕ" Foreground="#ADC4DF" FontSize="12" FontWeight="Bold" Margin="3,3,0,10"/>
                  <Button Style="{StaticResource Ghost}" Content="+ Добавить свой JAR" Click="AddJar_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="InstalledMods">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="9" Background="#223246" Margin="0,0,0,7" Padding="10,11">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                              <CheckBox Content="{Binding Title}" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanDisable}" Foreground="#EDF4FC" FontSize="13" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Subtitle}" Foreground="#8CA7C4" FontSize="11" Margin="20,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource Ghost}" Visibility="{Binding RemoveVisibility}" Tag="{Binding}" Click="RemoveMod_Click" Padding="9,6"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="13">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="КАТАЛОГ MODRINTH" Foreground="#ADC4DF" FontSize="12" FontWeight="Bold" Margin="3,3,0,5"/>
                  <TextBlock x:Name="SearchStatus" Text="Найди мод по названию или просмотри популярные." Foreground="#91ACC6" FontSize="11" Margin="3,0,0,12" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SearchResults">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="9" Background="#223246" Margin="0,0,0,7" Padding="11">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" Foreground="#E8F4FF" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding DownloadsText}" Foreground="#75B9F7" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="+ Добавить" Tag="{Binding}" Click="AddModrinth_Click" Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="39" Foreground="#94A9C1" FontSize="12" Margin="0,8,0,0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- CAPES -->
        <Grid x:Name="CapesPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Реалистичные плащи" FontSize="29" Foreground="#F2F8FF" FontWeight="SemiBold"/>
            <TextBlock Text="Своя текстура + анимация ткани через Wavey Capes." Foreground="#9EB3CE" Margin="0,7,0,17"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="268" Height="260" Background="#0D1622" BorderBrush="#425775" BorderThickness="1" CornerRadius="12">
                <Grid>
                  <TextBlock Text="ПРЕДПРОСМОТР" Foreground="#6F8EA9" Margin="12" VerticalAlignment="Top"/>
                  <Image x:Name="CapePreview" Stretch="Uniform" Margin="18,30,18,16"/>
                  <TextBlock x:Name="CapeEmptyText" Text="Пока нет своего плаща" Foreground="#9BB6CF" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="23,3,0,0">
                <TextBlock Text="Твой плащ" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Загрузи оригинальный PNG. Изображение сохраняется без потерь, а плащ создаётся в 2048×1024 без искажения картинки." Foreground="#A8C0D7" TextWrapping="Wrap" Margin="0,10,0,20"/>
                <CheckBox x:Name="CapeTemplateBox" Style="{StaticResource Option}" Content="PNG — готовая развёртка плаща (64×32 / 64×64)" Margin="0,0,0,13"/>
                <CheckBox x:Name="CapeEnabledBox" Style="{StaticResource Option}" Content="Показывать мой плащ" Checked="CapeEnabledChanged" Unchecked="CapeEnabledChanged" Margin="0,0,0,18"/>
                <WrapPanel>
                  <Button Content="Загрузить PNG" Style="{StaticResource Primary}" FontSize="14" Click="ImportCape_Click" Margin="0,0,9,9"/>
                  <Button Content="Убрать плащ" Style="{StaticResource Ghost}" Click="ClearCape_Click"/>
                </WrapPanel>
                <TextBlock x:Name="CapeStatusText" Text="Видимость локальная: плащ видишь ты." Foreground="#89A7C3" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,17,0,0" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="ФИЗИКА ТКАНИ" Foreground="#A2BCDA" FontWeight="Bold" FontSize="12"/>
              <TextBlock Text="Wavey Capes доступен в разделе Моды. Если включён, загружается с Modrinth перед игрой. Без него плащ будет анимирован стандартным Minecraft." Foreground="#D4E4F4" TextWrapping="Wrap" Margin="0,9,0,0"/>
              <TextBlock Text="Поддержка собственных плащей в LT6 — для версии Minecraft 1.21.11." Foreground="#7695B2" FontSize="12" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- FILES AND SKY -->
        <StackPanel x:Name="FilesPage" Visibility="Collapsed">
          <TextBlock Text="Файлы и Custom Sky" Foreground="#F2F8FF" FontSize="29" FontWeight="SemiBold"/>
          <TextBlock Text="Твои файлы остаются на компьютере. Шесть неба LT6 устанавливаются автоматически." Foreground="#9EB3CE" Margin="0,7,0,20"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="ПАПКИ ИГРЫ" Foreground="#AAC1DC" Margin="0,0,0,15" FontWeight="Bold"/>
              <WrapPanel>
                <Button Content="Minecraft" Style="{StaticResource Ghost}" Click="OpenGame_Click" Margin="0,0,10,10"/>
                <Button Content="Моды" Style="{StaticResource Ghost}" Click="OpenMods_Click" Margin="0,0,10,10"/>
                <Button Content="Текстурпаки" Style="{StaticResource Ghost}" Click="OpenPacks_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="CUSTOM SKY — 6 ПРЕСЕТОВ" Foreground="#AAC1DC" FontWeight="Bold" Margin="0,0,0,11"/>
              <TextBlock Text="Hardsok Clouds · Green Hardsok · Teal Storm · Akame Night · Klyrax Violet · Blue Moon" TextWrapping="Wrap" Foreground="#E7F1FC" FontSize="14"/>
              <TextBlock Text="При установке лаунчер обрабатывает край каждого участка skybox-атласа, чтобы уменьшить видимые швы и просветы." TextWrapping="Wrap" Foreground="#96B0C9" Margin="0,12,0,0"/>
              <TextBlock Text="Включи Custom Sky в игре: Y → Custom Sky." Foreground="#77BCFF" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="ИСТОЧНИК ФАЙЛОВ MINECRAFT" Foreground="#AAC1DC" FontWeight="Bold" Margin="0,0,0,11"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="S1" GroupName="sources" Content="Ускоряющие зеркала для файлов Minecraft" Foreground="#D7E6F5" Margin="0,0,20,0"/>
                <RadioButton x:Name="S2" GroupName="sources" Content="Официальные источники" Foreground="#D7E6F5"/>
              </StackPanel>
              <TextBlock Text="На скачивание модов этот переключатель не влияет: моды загружаются только с официального Modrinth." Foreground="#819BB8" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
